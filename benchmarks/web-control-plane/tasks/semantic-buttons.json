[
  {
    "id": "semantic-receipt-agent",
    "suite": "semantic-buttons",
    "title": "Choose the receipt proof button",
    "tool": "gemma_agent",
    "arguments": {
      "tabId": 101,
      "task": "get proof of last payment",
      "thinking": false,
      "maxIterations": 3
    },
    "expect": {
      "contains": ["#download-receipt", "INV-2026-041"],
      "bridgeExecuteTool": "read_page_content",
      "bridgeExecuteSelector": "body",
      "bridgeRunAgent": true
    }
  },
  {
    "id": "semantic-observe-json",
    "suite": "semantic-buttons",
    "title": "Observe the receipt action as valid JSON",
    "tool": "gemma_observe",
    "arguments": {
      "tabId": 101,
      "instruction": "find the control that downloads proof of the last payment"
    },
    "expect": {
      "json": "array",
      "selector": "#download-receipt",
      "method": "click",
      "bridgeExecuteTool": "read_page_content",
      "bridgeExecuteSelector": "body",
      "bridgeRunAgent": false
    }
  },
  {
    "id": "rank-receipt-actions",
    "suite": "semantic-buttons",
    "title": "Rank receipt action above billing distractors",
    "tool": "gemma_rank_actions",
    "arguments": {
      "task": {
        "id": "rank-receipt-actions",
        "suite": "semantic-buttons",
        "title": "find the control that downloads proof of the last payment",
        "tool": "gemma_observe"
      },
      "candidates": [
        {
          "description": "Invoice PDF (#download-invoice)",
          "method": "click",
          "arguments": ["#download-invoice"],
          "selector": "#download-invoice"
        },
        {
          "description": "Payment settings (#payment-settings)",
          "method": "click",
          "arguments": ["#payment-settings"],
          "selector": "#payment-settings"
        },
        {
          "description": "Receipt PDF (#download-receipt)",
          "method": "click",
          "arguments": ["#download-receipt"],
          "selector": "#download-receipt"
        }
      ]
    },
    "expect": {
      "json": "object",
      "jsonFields": {
        "best.candidate.selector": "#download-receipt",
        "model.type": "pairwise_perceptron"
      },
      "contains": ["pairwise_perceptron", "action-reranker.weights.json", "#download-receipt"],
      "bestSelector": "#download-receipt",
      "bridgeRunAgent": false
    }
  },
  {
    "id": "semantic-observed-act",
    "suite": "semantic-buttons",
    "title": "Execute observed receipt action without generation",
    "tool": "gemma_act",
    "arguments": {
      "tabId": 101,
      "action": {
        "description": "Receipt PDF (#download-receipt)",
        "method": "click",
        "arguments": ["#download-receipt"],
        "selector": "#download-receipt",
        "confidence": 0.97
      }
    },
    "expect": {
      "json": "object",
      "jsonFields": {
        "selector": "#download-receipt"
      },
      "contains": ["#download-receipt", "Receipt PDF"],
      "selector": "#download-receipt",
      "clicked": "#download-receipt",
      "bridgeExecuteTool": "click_element",
      "bridgeRunAgent": false
    }
  },
  {
    "id": "semantic-click-recover-selector",
    "suite": "semantic-buttons",
    "title": "Recover a receipt text-like click selector",
    "tool": "gemma_click",
    "arguments": {
      "tabId": 101,
      "selector": "button:has-text(\"Receipt PDF\")"
    },
    "expect": {
      "json": "object",
      "jsonFields": {
        "recovered": true,
        "recoveredSelector": "#download-receipt",
        "result.selector": "#download-receipt"
      },
      "contains": ["recoveredSelector", "#download-receipt", "Receipt PDF"],
      "selector": "#download-receipt",
      "clicked": "#download-receipt",
      "bridgeExecuteTools": ["read_page_content", "click_element"],
      "bridgeExecuteSelectors": ["body", "#download-receipt"],
      "bridgeRunAgent": false
    }
  },
  {
    "id": "semantic-act-multi-reject",
    "suite": "semantic-buttons",
    "title": "Reject multi-step action prompt",
    "tool": "gemma_act",
    "arguments": {
      "tabId": 101,
      "instruction": "click the receipt button and then open payment settings"
    },
    "expect": {
      "json": "object",
      "jsonFields": {
        "error": "ERROR_MULTIPLE_ACTIONS",
        "instruction": "click the receipt button and then open payment settings"
      },
      "contains": ["ERROR_MULTIPLE_ACTIONS", "gemma_agent"],
      "bridgeRunAgent": false
    }
  },
  {
    "id": "semantic-page-brief",
    "suite": "semantic-buttons",
    "title": "Brief exposes meaningful billing controls",
    "tool": "gemma_page_brief",
    "arguments": {
      "tabId": 101,
      "selector": "body",
      "format": "text",
      "maxChars": 4000
    },
    "expect": {
      "json": "object",
      "jsonFields": {
        "selector": "body",
        "format": "text",
        "interactiveControls.0.selector": "#download-receipt",
        "interactiveControls.0.label": "Receipt PDF",
        "interactiveControls.0.tag": "button",
        "interactiveControls.1.selector": "#download-invoice",
        "interactiveControls.2.selector": "#payment-settings",
        "interactiveControls.2.label": "Payment settings"
      },
      "contains": ["Receipt PDF", "Payment settings", "INV-2026-041", "\"selector\": \"#download-receipt\"", "\"selector\": \"#payment-settings\""],
      "bridgeExecuteTool": "read_page_content",
      "bridgeExecuteSelector": "body",
      "bridgeListTabs": true,
      "bridgeRunAgent": false
    }
  }
]
