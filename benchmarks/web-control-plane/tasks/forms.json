  {
    "id": "transfer-profile-fields",
    "suite": "forms",
    "title": "Transfer account fields between tabs",
    "tool": "gemma_transfer_fields",
    "arguments": {
      "sourceTabId": 103,
      "destinationTabId": 104,
      "mappings": [
        {
          "label": "Full name",
          "fromSelector": "#source-name",
          "toSelector": "#dest-name"
        },
        {
          "label": "Email",
          "fromSelector": "#source-email",
          "toSelector": "#dest-email"
        }
      ],
      "submitSelector": "#save-profile",
      "resultSelector": "#save-result"
    },
    "expect": {
      "json": "object",
      "jsonFields": {
        "ok": true,
        "copiedFields.0.fromSelector": "#source-name",
        "copiedFields.0.toSelector": "#dest-name",
        "copiedFields.0.value": "Ada Lovelace",
        "copiedFields.1.fromSelector": "#source-email",
        "copiedFields.1.toSelector": "#dest-email",
        "copiedFields.1.value": "ada@example.test",
        "submitSelector": "#save-profile",
        "submitResult.selector": "#save-profile",
        "resultSelector": "#save-result"
      },
      "jsonFieldIncludes": {
        "destinationResult.content": ["Saved Ada Lovelace", "ada@example.test"],
        "peerSummary.action": "Copied mapped source fields"
      },
      "jsonFieldMinItems": {
        "copiedFields": 2
      },
      "jsonFieldItemCount": {
        "copiedFields": 2
      },
      "contains": ["Ada Lovelace", "ada@example.test", "Copied mapped source fields", "Saved Ada Lovelace"],
      "destinationValues": {
        "#dest-name": "Ada Lovelace",
        "#dest-email": "ada@example.test"
      },
      "clicked": "#save-profile",
      "actions": 6,
      "actionTraceTools": ["read_page_content", "type_text", "read_page_content", "type_text", "click_element", "read_page_content"],
      "actionTraceTextIncludes": ["selector=#source-name", "selector=#dest-name", "selector=#source-email", "selector=#dest-email", "selector=#save-profile", "selector=#save-result"],
      "bridgeExecuteTools": ["read_page_content", "type_text", "click_element"],
      "bridgeExecuteSelectors": ["#source-name", "#source-email", "#dest-name", "#dest-email", "#save-profile", "#save-result"],
      "bridgeRunAgent": false
    }
  }
