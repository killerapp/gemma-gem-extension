[
  {
    "id": "forms-page-brief-controls",
    "suite": "forms",
    "title": "Brief exposes destination form controls",
    "tool": "gemma_page_brief",
    "arguments": {
      "tabId": 104,
      "selector": "body",
      "format": "text",
      "maxChars": 4000
    },
    "expect": {
      "json": "object",
      "jsonFields": {
        "tab.title": "Profile destination",
        "selector": "body",
        "format": "text",
        "interactiveControls.0.selector": "#dest-name",
        "interactiveControls.0.label": "Name",
        "interactiveControls.0.tag": "input",
        "interactiveControls.0.name": "name",
        "interactiveControls.3.selector": "#save-profile",
        "interactiveControls.3.label": "Save profile",
        "interactiveControls.3.tag": "button"
      },
      "jsonFieldIncludes": {
        "content": ["Name", "Email", "Role", "Save profile"]
      },
      "jsonFieldMinItems": {
        "interactiveControls": 4
      },
      "jsonFieldItemCount": {
        "interactiveControls": 4
      },
      "actions": 2,
      "actionTraceTools": ["read_page_content", "read_page_content"],
      "actionTraceTextIncludes": ["selector=body format=text", "selector=body format=html"],
      "contains": ["interactiveControls", "\"selector\": \"#dest-name\"", "\"label\": \"Name\"", "\"tag\": \"input\"", "\"name\": \"name\"", "\"selector\": \"#save-profile\""],
      "bridgeExecuteTool": "read_page_content",
      "bridgeExecuteSelector": "body",
      "bridgeListTabs": true,
      "bridgeRunAgent": false
    }
  },
  {
    "id": "type-text-recover-selector",
    "suite": "forms",
    "title": "Recover a name text-like type selector",
    "tool": "gemma_type_text",
    "arguments": {
      "tabId": 104,
      "selector": "text=Name",
      "text": "Grace Hopper"
    },
    "expect": {
      "json": "object",
      "jsonFields": {
        "recovered": true,
        "recoveredSelector": "#dest-name",
        "result.into": "#dest-name"
      },
      "contains": ["recoveredSelector", "#dest-name", "Grace Hopper"],
      "destinationValues": {
        "#dest-name": "Grace Hopper"
      },
      "actions": 3,
      "actionTraceTools": ["read_page_content", "read_page_content", "type_text"],
      "actionTraceTextIncludes": ["selector=body format=text", "selector=body format=html", "selector=#dest-name"],
      "bridgeExecuteTools": ["read_page_content", "type_text"],
      "bridgeExecuteSelectors": ["body", "#dest-name"],
      "bridgeRunAgent": false
    }
  },
  {
    "id": "read-destination-name-after-type",
    "suite": "forms",
    "title": "Read typed destination name by selector",
    "tool": "gemma_read_page",
    "arguments": {
      "tabId": 104,
      "selector": "#dest-name",
      "format": "text"
    },
    "expect": {
      "json": "object",
      "jsonFieldIncludes": {
        "content": ["Grace Hopper"]
      },
      "contains": ["Grace Hopper"],
      "notContains": ["Reviewer", "ada@example.test"],
      "selector": "#dest-name",
      "actions": 1,
      "actionTraceTools": ["read_page_content"],
      "actionTraceTextIncludes": ["selector=#dest-name format=text"],
      "bridgeExecuteTool": "read_page_content",
      "bridgeExecuteSelector": "#dest-name",
      "bridgeRunAgent": false
    }
  },
  {
    "id": "select-role-label",
    "suite": "forms",
    "title": "Select a role option by visible label",
    "tool": "gemma_select_option",
    "arguments": {
      "tabId": 104,
      "selector": "#dest-role",
      "label": "Reviewer"
    },
    "expect": {
      "json": "object",
      "jsonFields": {
        "selected": "Reviewer",
        "value": "reviewer",
        "selector": "#dest-role"
      },
      "contains": ["Reviewer", "reviewer", "#dest-role"],
      "destinationValues": {
        "#dest-role": "reviewer"
      },
      "actions": 1,
      "actionTraceTools": ["select_option"],
      "actionTraceTextIncludes": ["selector=#dest-role label=Reviewer"],
      "bridgeExecuteTool": "select_option",
      "bridgeExecuteSelector": "#dest-role",
      "bridgeRunAgent": false
    }
  },
