[
  {
    "id": "forms-page-brief-controls",
    "suite": "forms",
    "title": "Brief exposes destination form controls",
    "tool": "gemma_page_brief",
    "arguments": {
      "tabId": 104,
      "selector": "body",
      "format": "text",
      "maxChars": 4000
    },
    "expect": {
      "json": "object",
      "jsonFields": {
        "tab.title": "Profile destination",
        "selector": "body",
        "format": "text",
        "interactiveControls.0.selector": "#dest-name",
        "interactiveControls.0.label": "Name",
        "interactiveControls.0.tag": "input",
        "interactiveControls.0.name": "name",
        "interactiveControls.3.selector": "#save-profile",
        "interactiveControls.3.label": "Save profile",
        "interactiveControls.3.tag": "button"
      },
      "jsonFieldIncludes": {
        "content": ["Name", "Email", "Role", "Save profile"]
      },
      "contains": ["interactiveControls", "\"selector\": \"#dest-name\"", "\"label\": \"Name\"", "\"tag\": \"input\"", "\"name\": \"name\"", "\"selector\": \"#save-profile\""],
      "bridgeExecuteTool": "read_page_content",
      "bridgeExecuteSelector": "body",
      "bridgeListTabs": true,
      "bridgeRunAgent": false
    }
  },
  {
    "id": "type-text-recover-selector",
    "suite": "forms",
    "title": "Recover a name text-like type selector",
    "tool": "gemma_type_text",
    "arguments": {
      "tabId": 104,
      "selector": "text=Name",
      "text": "Grace Hopper"
    },
    "expect": {
      "json": "object",
      "jsonFields": {
        "recovered": true,
        "recoveredSelector": "#dest-name",
        "result.into": "#dest-name"
      },
      "contains": ["recoveredSelector", "#dest-name", "Grace Hopper"],
      "destinationValues": {
        "#dest-name": "Grace Hopper"
      },
      "bridgeExecuteTools": ["read_page_content", "type_text"],
      "bridgeExecuteSelectors": ["body", "#dest-name"],
      "bridgeRunAgent": false
    }
  },
  {
    "id": "select-role-label",
    "suite": "forms",
    "title": "Select a role option by visible label",
    "tool": "gemma_select_option",
    "arguments": {
      "tabId": 104,
      "selector": "#dest-role",
      "label": "Reviewer"
    },
    "expect": {
      "json": "object",
      "jsonFields": {
        "selected": "Reviewer",
        "value": "reviewer",
        "selector": "#dest-role"
      },
      "contains": ["Reviewer", "reviewer", "#dest-role"],
      "destinationValues": {
        "#dest-role": "reviewer"
      },
      "bridgeExecuteTool": "select_option",
      "bridgeExecuteSelector": "#dest-role",
      "bridgeRunAgent": false
    }
  },
  {
    "id": "transfer-profile-fields",
    "suite": "forms",
    "title": "Transfer account fields between tabs",
    "tool": "gemma_transfer_fields",
    "arguments": {
      "sourceTabId": 103,
      "destinationTabId": 104,
      "mappings": [
        {
          "label": "Full name",
          "fromSelector": "#source-name",
          "toSelector": "#dest-name"
        },
        {
          "label": "Email",
          "fromSelector": "#source-email",
          "toSelector": "#dest-email"
        }
      ],
      "submitSelector": "#save-profile",
      "resultSelector": "#save-result"
    },
    "expect": {
      "json": "object",
      "jsonFields": {
        "ok": true,
        "copiedFields.0.fromSelector": "#source-name",
        "copiedFields.0.toSelector": "#dest-name",
        "copiedFields.0.value": "Ada Lovelace",
        "copiedFields.1.fromSelector": "#source-email",
        "copiedFields.1.toSelector": "#dest-email",
        "copiedFields.1.value": "ada@example.test",
        "submitSelector": "#save-profile",
        "submitResult.selector": "#save-profile",
        "resultSelector": "#save-result"
      },
      "jsonFieldIncludes": {
        "destinationResult.content": ["Saved Ada Lovelace", "ada@example.test"],
        "peerSummary.action": "Copied mapped source fields"
      },
      "contains": ["Ada Lovelace", "ada@example.test", "Copied mapped source fields", "Saved Ada Lovelace"],
      "destinationValues": {
        "#dest-name": "Ada Lovelace",
        "#dest-email": "ada@example.test"
      },
      "clicked": "#save-profile",
      "bridgeExecuteTools": ["read_page_content", "type_text", "click_element"],
      "bridgeExecuteSelectors": ["#source-name", "#source-email", "#dest-name", "#dest-email", "#save-profile", "#save-result"],
      "bridgeRunAgent": false
    }
  }
]
