[
  {
    "id": "forms-page-brief-controls",
    "suite": "forms",
    "title": "Brief exposes destination form controls",
    "tool": "gemma_page_brief",
    "arguments": {
      "tabId": 104,
      "selector": "body",
      "format": "text",
      "maxChars": 4000
    },
    "expect": {
      "json": "object",
      "jsonFields": {
        "tab.title": "Profile destination",
        "selector": "body",
        "format": "text",
        "interactiveControls.0.selector": "#dest-name",
        "interactiveControls.0.label": "Name",
        "interactiveControls.0.tag": "input",
        "interactiveControls.0.name": "name",
        "interactiveControls.3.selector": "#dest-updates",
        "interactiveControls.3.label": "Subscribe updates",
        "interactiveControls.3.tag": "input",
        "interactiveControls.3.name": "updates",
        "interactiveControls.3.value": "subscribe",
        "interactiveControls.4.selector": "#dest-priority-low",
        "interactiveControls.4.label": "Priority Low",
        "interactiveControls.4.tag": "input",
        "interactiveControls.4.name": "priority",
        "interactiveControls.4.value": "low",
        "interactiveControls.5.selector": "#dest-priority-high",
        "interactiveControls.5.label": "Priority High",
        "interactiveControls.5.tag": "input",
        "interactiveControls.5.name": "priority",
        "interactiveControls.5.value": "high",
        "interactiveControls.6.selector": "#dest-notes",
        "interactiveControls.6.label": "Notes",
        "interactiveControls.6.tag": "textarea",
        "interactiveControls.6.name": "notes",
        "interactiveControls.7.selector": "#save-profile",
        "interactiveControls.7.label": "Save profile",
        "interactiveControls.7.tag": "button"
      },
      "jsonFieldIncludes": {
        "content": ["Name", "Email", "Role", "Subscribe updates", "Priority Low", "Priority High", "Notes", "Save profile"]
      },
      "jsonFieldMinItems": {
        "interactiveControls": 8
      },
      "jsonFieldItemCount": {
        "interactiveControls": 8
      },
      "actions": 2,
      "actionTraceTools": ["read_page_content", "read_page_content"],
      "actionTraceTextIncludes": ["selector=body format=text", "selector=body format=html"],
      "contains": ["interactiveControls", "\"selector\": \"#dest-name\"", "\"label\": \"Name\"", "\"tag\": \"input\"", "\"name\": \"name\"", "\"selector\": \"#dest-updates\"", "\"selector\": \"#dest-priority-low\"", "\"selector\": \"#dest-priority-high\"", "\"selector\": \"#dest-notes\"", "\"selector\": \"#save-profile\""],
      "bridgeExecuteTool": "read_page_content",
      "bridgeExecuteSelector": "body",
      "bridgeListTabs": true,
      "bridgeRunAgent": false
    }
  },
  {
    "id": "type-text-recover-selector",
    "suite": "forms",
    "title": "Recover a name text-like type selector",
    "tool": "gemma_type_text",
    "arguments": {
      "tabId": 104,
      "selector": "text=Name",
      "text": "Grace Hopper"
    },
    "expect": {
      "json": "object",
      "jsonFields": {
        "recovered": true,
        "recoveredSelector": "#dest-name",
        "result.into": "#dest-name"
      },
      "contains": ["recoveredSelector", "#dest-name", "Grace Hopper"],
      "destinationValues": {
        "#dest-name": "Grace Hopper"
      },
      "actions": 3,
      "actionTraceTools": ["read_page_content", "read_page_content", "type_text"],
      "actionTraceTextIncludes": ["selector=body format=text", "selector=body format=html", "selector=#dest-name"],
      "bridgeExecuteTools": ["read_page_content", "type_text"],
      "bridgeExecuteSelectors": ["body", "#dest-name"],
      "bridgeRunAgent": false
    }
  },
