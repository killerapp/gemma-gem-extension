  {
    "id": "pricing-page-brief-no-controls",
    "suite": "extraction",
    "title": "Brief exposes pricing content without interactive controls",
    "tool": "gemma_page_brief",
    "arguments": {
      "tabId": 102,
      "selector": "body",
      "format": "text",
      "maxChars": 4000
    },
    "expect": {
      "json": "object",
      "jsonFields": {
        "tab.title": "Pricing sandbox",
        "selector": "body",
        "format": "text"
      },
      "jsonFieldIncludes": {
        "tab.url": ["extraction.html"],
        "content": ["Starter", "$19/month", "Team", "$49/month"]
      },
      "jsonFieldItemCount": {
        "interactiveControls": 0
      },
      "actions": 2,
      "actionTraceTools": ["read_page_content", "read_page_content"],
      "actionTraceTextIncludes": ["selector=body format=text", "selector=body format=html"],
      "contains": ["Pricing sandbox", "extraction.html", "Starter", "$19/month", "Team", "$49/month", "\"interactiveControls\": []"],
      "bridgeExecuteTool": "read_page_content",
      "bridgeExecuteSelector": "body",
      "bridgeListTabs": true,
      "bridgeRunAgent": false
    }
