[
  {
    "id": "extract-pricing-json",
    "suite": "extraction",
    "title": "Extract pricing cards as strict JSON",
    "tool": "gemma_extract",
    "arguments": {
      "tabId": 102,
      "instruction": "extract the pricing plans and monthly prices",
      "schema": {
        "type": "object",
        "properties": {
          "plans": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": { "type": "string" },
                "price": { "type": "string" }
              },
              "required": ["name", "price"]
            }
          }
        },
        "required": ["plans"]
      }
    },
    "expect": {
      "json": "object",
      "jsonFields": {
        "plans.0.name": "Starter",
        "plans.0.price": "$19/month",
        "plans.1.name": "Team",
        "plans.1.price": "$49/month"
      },
      "jsonFieldMinItems": {
        "plans": 2
      },
      "jsonFieldItemCount": {
        "plans": 2
      },
      "contains": ["Starter", "$19", "Team", "$49"],
      "schemaValid": true,
      "minPlans": 2,
      "actions": 3,
      "actionTraceTools": ["read_page_content", "read_page_content", "gemma_agent"],
      "actionTraceTextIncludes": ["selector=body format=text", "selector=body format=html", "gemma_extract"],
      "bridgeExecuteTool": "read_page_content",
      "bridgeExecuteSelector": "body",
      "bridgeRunAgent": true
    }
  },
  {
    "id": "extract-scoped-plan-json",
    "suite": "extraction",
    "title": "Extract a selector-scoped pricing plan",
    "tool": "gemma_extract",
    "arguments": {
      "tabId": 102,
      "selector": ".plan[data-plan=\"team\"]",
      "instruction": "extract the selected pricing plan and monthly price",
      "schema": {
        "type": "object",
        "properties": {
          "plan": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "price": { "type": "string" }
            },
            "required": ["name", "price"]
          }
        },
        "required": ["plan"]
      }
    },
    "expect": {
      "json": "object",
      "jsonFields": {
        "plan.name": "Team",
        "plan.price": "$49/month"
      },
      "contains": ["Team", "$49"],
      "notContains": ["Starter", "$19"],
      "schemaValid": true,
      "actions": 3,
      "actionTraceTools": ["read_page_content", "read_page_content", "gemma_agent"],
      "actionTraceTextIncludes": ["selector=.plan[data-plan=\"team\"] format=text", "selector=.plan[data-plan=\"team\"] format=html", "Scope selector: .plan[data-plan=\"team\"]"],
      "bridgeExecuteTool": "read_page_content",
      "bridgeExecuteSelector": ".plan[data-plan=\"team\"]",
      "bridgeRunAgent": true
    }
  },
