[
  {
    "id": "extract-pricing-json",
    "suite": "extraction",
    "title": "Extract pricing cards as strict JSON",
    "tool": "gemma_extract",
    "arguments": {
      "tabId": 102,
      "instruction": "extract the pricing plans and monthly prices",
      "schema": {
        "type": "object",
        "properties": {
          "plans": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": { "type": "string" },
                "price": { "type": "string" }
              },
              "required": ["name", "price"]
            }
          }
        },
        "required": ["plans"]
      }
    },
    "expect": {
      "json": "object",
      "contains": ["Starter", "$19", "Team", "$49"],
      "schemaValid": true,
      "minPlans": 2,
      "bridgeExecuteTool": "read_page_content",
      "bridgeExecuteSelector": "body",
      "bridgeRunAgent": true
    }
  },
  {
    "id": "extract-scoped-plan-json",
    "suite": "extraction",
    "title": "Extract a selector-scoped pricing plan",
    "tool": "gemma_extract",
    "arguments": {
      "tabId": 102,
      "selector": ".plan[data-plan=\"team\"]",
      "instruction": "extract the selected pricing plan and monthly price",
      "schema": {
        "type": "object",
        "properties": {
          "plan": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "price": { "type": "string" }
            },
            "required": ["name", "price"]
          }
        },
        "required": ["plan"]
      }
    },
    "expect": {
      "json": "object",
      "contains": ["Team", "$49"],
      "notContains": ["Starter", "$19"],
      "schemaValid": true,
      "bridgeExecuteTool": "read_page_content",
      "bridgeExecuteSelector": ".plan[data-plan=\"team\"]",
      "bridgeRunAgent": true
    }
  },
  {
    "id": "read-scoped-plan",
    "suite": "extraction",
    "title": "Read only a selector-scoped pricing plan",
    "tool": "gemma_read_page",
    "arguments": {
      "tabId": 102,
      "selector": ".plan[data-plan=\"team\"]",
      "format": "text"
    },
    "expect": {
      "json": "object",
      "contains": ["Team", "$49"],
      "notContains": ["Starter", "$19"],
      "bridgeExecuteTool": "read_page_content",
      "bridgeExecuteSelector": ".plan[data-plan=\"team\"]",
      "bridgeRunAgent": false
    }
  }
]
