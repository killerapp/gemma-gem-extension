[
  {
    "id": "adversarial-billing-page-brief-duplicates",
    "suite": "adversarial-billing",
    "title": "Brief exposes duplicate invoice labels as distinct selectors",
    "tool": "gemma_page_brief",
    "arguments": {
      "tabId": 107,
      "selector": "body",
      "format": "text"
    },
    "expect": {
      "json": "object",
      "jsonFields": {
        "selector": "body",
        "interactiveControls.1.selector": "#primary-invoice-download",
        "interactiveControls.3.selector": "#archive-invoice-download"
      },
      "jsonFieldIncludes": {
        "content": ["Current invoice INV-2026-041", "Archive invoice INV-2025-009", "No billing document downloaded"]
      },
      "jsonFieldItemCount": {
        "interactiveControls": 4
      },
      "contains": ["#primary-invoice-download", "#archive-invoice-download", "Invoice PDF", "INV-2026-041", "INV-2025-009"],
      "selector": "body",
      "actions": 2,
      "actionTraceTools": ["read_page_content", "read_page_content"],
      "actionTraceTextIncludes": ["selector=body format=text", "selector=body format=html"],
      "bridgeExecuteTool": "read_page_content",
      "bridgeExecuteSelector": "body",
      "bridgeRunAgent": false
    }
  },
  {
