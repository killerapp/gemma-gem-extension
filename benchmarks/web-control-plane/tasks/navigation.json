[
  {
    "id": "tabs-contract",
    "suite": "navigation",
    "title": "List addressable browser fixture tabs",
    "tool": "gemma_tabs",
    "arguments": {},
    "expect": {
      "json": "array",
      "minItems": 5,
      "contains": ["Billing sandbox", "Pricing sandbox", "Profile source", "Profile destination", "Navigation sandbox"],
      "actions": 0,
      "bridgeListTabs": true,
      "bridgeRunAgent": false
    }
  },
  {
    "id": "active-tab-contract",
    "suite": "navigation",
    "title": "Active tab metadata is available to caller agents",
    "tool": "gemma_active_tab",
    "arguments": {},
    "expect": {
      "json": "object",
      "jsonFields": {
        "title": "Billing sandbox"
      },
      "jsonFieldIncludes": {
        "url": "semantic-buttons.html"
      },
      "contains": ["Billing sandbox", "semantic-buttons.html"],
      "activeTabId": 101,
      "actions": 0,
      "bridgeGetActiveTab": true,
      "bridgeRunAgent": false
    }
  },
  {
    "id": "model-ready-contract",
    "suite": "navigation",
    "title": "Model readiness returns bounded diagnostic status",
    "tool": "gemma_model_ready",
    "arguments": {
      "timeoutMs": 1000
    },
    "expect": {
      "json": "object",
      "jsonFields": {
        "modelId": "gemma-4-e2b",
        "status": "ready",
        "progress": 100
      },
      "jsonFieldsByMode": {
        "local-fake-extension": {
          "phase": "fake-ready"
        },
        "real-chrome-extension-agent": {
          "phase": "already-loaded"
        }
      },
      "contains": ["ready", "gemma-4-e2b", "progress"],
      "containsByMode": {
        "local-fake-extension": ["fake-ready"],
        "real-chrome-extension-agent": ["already-loaded"]
      },
      "actions": 0,
      "bridgeEnsureModelReady": true,
      "bridgeRunAgent": false
    }
  },
  {
    "id": "screenshot-contract",
    "suite": "navigation",
    "title": "Screenshot returns MCP image content",
    "tool": "gemma_screenshot",
    "arguments": {
      "tabId": 101
    },
    "expect": {
      "image": "image/png",
      "actions": 1,
      "actionTraceTools": ["take_screenshot"],
      "bridgeExecuteTool": "take_screenshot",
      "bridgeRunAgent": false
    }
  },
  {
    "id": "stop-contract",
    "suite": "navigation",
    "title": "Stop active browser task returns a bounded acknowledgement",
    "tool": "gemma_stop",
    "arguments": {
      "runId": "benchmark-stop"
    },
    "expect": {
      "json": "object",
      "jsonFields": {
        "stopped": true,
        "runId": "benchmark-stop"
      },
      "contains": ["stopped", "true", "benchmark-stop"],
      "bridgeStop": true,
      "bridgeRunAgent": false
    }
  },
  {
    "id": "scroll-contract",
    "suite": "navigation",
    "title": "Scroll page changes viewport position",
    "tool": "gemma_scroll",
    "arguments": {
      "tabId": 105,
      "amount": 700
    },
    "expect": {
      "json": "object",
      "jsonFields": {
        "scrolled": "down 700px",
        "scrollY": 700
      },
      "contains": ["down 700px", "scrollY"],
      "scrollYAtLeast": 650,
      "actions": 1,
      "actionTraceTools": ["scroll_page"],
      "bridgeExecuteTool": "scroll_page",
      "bridgeRunAgent": false
    }
  }
]
