[
  {
    "id": "tabs-contract",
    "suite": "navigation",
    "title": "List addressable browser fixture tabs",
    "tool": "gemma_tabs",
    "arguments": {},
    "expect": {
      "json": "array",
      "minItems": 5,
      "contains": ["Billing sandbox", "Pricing sandbox", "Profile source", "Profile destination", "Navigation sandbox"],
      "actions": 0,
      "bridgeListTabs": true,
      "bridgeRunAgent": false
    }
  },
  {
    "id": "active-tab-contract",
    "suite": "navigation",
    "title": "Active tab metadata is available to caller agents",
    "tool": "gemma_active_tab",
    "arguments": {},
    "expect": {
      "json": "object",
      "jsonFields": {
        "title": "Billing sandbox"
      },
      "jsonFieldIncludes": {
        "url": "semantic-buttons.html"
      },
      "contains": ["Billing sandbox", "semantic-buttons.html"],
      "activeTabId": 101,
      "actions": 0,
      "bridgeGetActiveTab": true,
      "bridgeRunAgent": false
    }
  },
  {
    "id": "model-ready-contract",
    "suite": "navigation",
    "title": "Model readiness returns bounded diagnostic status",
    "tool": "gemma_model_ready",
    "arguments": {
      "timeoutMs": 1000
    },
    "expect": {
      "json": "object",
      "jsonFields": {
        "modelId": "gemma-4-e2b",
        "status": "ready",
        "progress": 100
      },
      "jsonFieldsByMode": {
        "local-fake-extension": {
          "phase": "fake-ready"
        },
        "real-chrome-extension-agent": {
          "phase": "already-loaded"
        }
      },
      "contains": ["ready", "gemma-4-e2b", "progress"],
      "containsByMode": {
        "local-fake-extension": ["fake-ready"],
        "real-chrome-extension-agent": ["already-loaded"]
      },
      "actions": 0,
      "bridgeEnsureModelReady": true,
      "bridgeRunAgent": false
    }
  },
  {
    "id": "screenshot-contract",
    "suite": "navigation",
    "title": "Screenshot returns MCP image content",
    "tool": "gemma_screenshot",
    "arguments": {
      "tabId": 101
    },
    "expect": {
      "image": "image/png",
      "actions": 1,
      "actionTraceTools": ["take_screenshot"],
      "actionTraceTextIncludes": ["take_screenshot"],
      "bridgeExecuteTool": "take_screenshot",
      "bridgeRunAgent": false
    }
  },
  {
    "id": "stop-contract",
    "suite": "navigation",
    "title": "Stop active browser task returns a bounded acknowledgement",
    "tool": "gemma_stop",
    "arguments": {
      "runId": "benchmark-stop"
    },
    "expect": {
      "json": "object",
      "jsonFields": {
        "stopped": true,
        "runId": "benchmark-stop"
      },
      "contains": ["stopped", "true", "benchmark-stop"],
      "bridgeStop": true,
      "bridgeRunAgent": false
    }
  },
  {
    "id": "navigation-page-brief-links",
    "suite": "navigation",
    "title": "Brief exposes navigation page links",
    "tool": "gemma_page_brief",
    "arguments": {
      "tabId": 105,
      "selector": "body",
      "format": "text",
      "maxChars": 4000
    },
    "expect": {
      "json": "object",
      "jsonFields": {
        "tab.title": "Navigation sandbox",
        "selector": "body",
        "format": "text",
        "interactiveControls.0.selector": "#settings-link",
        "interactiveControls.0.label": "Settings",
        "interactiveControls.0.tag": "a",
        "interactiveControls.1.selector": "#billing-link",
        "interactiveControls.1.label": "Billing",
        "interactiveControls.1.tag": "a"
      },
      "jsonFieldIncludes": {
        "content": ["Settings", "Billing", "Scroll target reached"]
      },
      "jsonFieldMinItems": {
        "interactiveControls": 2
      },
      "jsonFieldItemCount": {
        "interactiveControls": 2
      },
      "actions": 2,
      "actionTraceTools": ["read_page_content", "read_page_content"],
      "actionTraceTextIncludes": ["selector=body format=text", "selector=body format=html"],
      "contains": ["Settings", "Billing", "\"selector\": \"#settings-link\"", "\"selector\": \"#billing-link\"", "\"tag\": \"a\""],
      "bridgeExecuteTool": "read_page_content",
      "bridgeExecuteSelector": "body",
      "bridgeListTabs": true,
      "bridgeRunAgent": false
    }
  },
  {
    "id": "scroll-contract",
    "suite": "navigation",
    "title": "Scroll page changes viewport position",
    "tool": "gemma_scroll",
    "arguments": {
      "tabId": 105,
      "amount": 700
    },
    "expect": {
      "json": "object",
      "jsonFields": {
        "scrolled": "down 700px",
        "scrollY": 700
      },
      "contains": ["down 700px", "scrollY"],
      "scrollYAtLeast": 650,
      "actions": 1,
      "actionTraceTools": ["scroll_page"],
      "actionTraceTextIncludes": ["direction=down amount=700"],
      "bridgeExecuteTool": "scroll_page",
      "bridgeRunAgent": false
    }
  },
  {
    "id": "scroll-up-contract",
    "suite": "navigation",
    "title": "Negative scroll moves viewport upward",
    "tool": "gemma_scroll",
    "arguments": {
      "tabId": 105,
      "amount": -300
    },
    "expect": {
      "json": "object",
      "jsonFields": {
        "scrolled": "up 300px",
        "scrollY": 400
      },
      "contains": ["up 300px", "scrollY"],
      "scrollYAtLeast": 350,
      "scrollYAtMost": 450,
      "actions": 1,
      "actionTraceTools": ["scroll_page"],
      "actionTraceTextIncludes": ["direction=up amount=300"],
      "bridgeExecuteTool": "scroll_page",
      "bridgeRunAgent": false
    }
  }
]
