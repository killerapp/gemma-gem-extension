  {
    "id": "click-settings-link",
    "suite": "navigation",
    "title": "Click navigation link changes page URL",
    "tool": "gemma_click",
    "arguments": {
      "tabId": 105,
      "selector": "#settings-link"
    },
    "expect": {
      "json": "object",
      "jsonFields": {
