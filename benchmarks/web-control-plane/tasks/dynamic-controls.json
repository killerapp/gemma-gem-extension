    "title": "Brief exposes React library dynamic control triggers",
    "tool": "gemma_page_brief",
    "arguments": {
      "tabId": 108,
      "selector": "body",
      "format": "text"
    },
    "expect": {
      "json": "object",
      "jsonFields": {
        "selector": "body",
        "interactiveControls.0.selector": "#react-assignee-control",
        "interactiveControls.1.selector": "#radix-priority-trigger",
        "interactiveControls.2.selector": "#headless-export-button",
        "interactiveControls.3.selector": "#mui-notifications-switch"
      },
      "jsonFieldIncludes": {
        "content": ["React Select-style assignee", "Radix Select-style priority", "Headless UI menu export", "MUI Switch-style notifications"]
      },
      "jsonFieldItemCount": {
        "interactiveControls": 4
      },
      "contains": ["#react-assignee-control", "#radix-priority-trigger", "#headless-export-button", "#mui-notifications-switch"],
      "selector": "body",
      "actions": 2,
      "actionTraceTools": ["read_page_content", "read_page_content"],
      "actionTraceTextIncludes": ["selector=body format=text", "selector=body format=html"],
      "bridgeExecuteTool": "read_page_content",
      "bridgeExecuteSelector": "body",
      "bridgeRunAgent": false
    }
  },
