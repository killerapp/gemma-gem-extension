{
  "name": "gemma-gem",
  "description": "Browser AI agent powered by Gemma 4 via WebGPU",
  "license": "Apache-2.0",
  "version": "0.3.0",
  "type": "module",
  "bin": {
    "gemma-gem-bridge": "host/bin/gemma-gem-bridge.cjs"
  },
  "files": [
    "host/bin",
    "host/scripts/stop-bridge.cjs",
    "docs/*.md",
    "host/src",
    "scripts/postinstall.cjs",
    "shared/bridge-messages.ts",
    "shared/bridge-settings.ts",
    "shared/messages.ts",
    "shared/models.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build --mode development",
    "build:prod": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "bridge": "node --import tsx host/src/index.ts",
    "bridge:http": "node --import tsx host/src/index.ts --http",
    "bridge:stop": "node host/scripts/stop-bridge.cjs",
    "browser:install": "tsx scripts/install-chrome-for-testing.ts",
    "browser:debug": "tsx scripts/launch-extension-debug.ts",
    "browser:model-ready": "tsx scripts/check-model-ready.ts",
    "benchmark:web": "tsx benchmarks/web-control-plane/run.ts",
    "benchmark:traces": "tsx benchmarks/web-control-plane/export-traces.ts",
    "benchmark:traces:check": "tsx benchmarks/web-control-plane/check-traces.ts --min-records 17 --min-positive 17 --min-selectors 14 --min-clicks 2 --min-candidate-buckets 8",
    "benchmark:traces:summary": "tsx benchmarks/web-control-plane/summarize-traces.ts",
    "benchmark:traces:training": "tsx benchmarks/web-control-plane/build-training-traces.ts",
    "benchmark:traces:training:check": "tsx benchmarks/web-control-plane/check-traces.ts --input benchmarks/web-control-plane/action-traces.training.jsonl --require-negative --require-candidate-pairs --min-records 35 --min-positive 20 --min-negative 15 --min-selectors 32 --min-clicks 10 --min-candidate-buckets 9 --min-paired-candidate-buckets 9",
    "benchmark:traces:training:summary": "tsx benchmarks/web-control-plane/summarize-traces.ts --input benchmarks/web-control-plane/action-traces.training.jsonl --output benchmarks/web-control-plane/action-traces.training.summary.md",
    "benchmark:traces:preferences": "tsx benchmarks/web-control-plane/build-preference-pairs.ts",
    "benchmark:traces:preferences:check": "tsx benchmarks/web-control-plane/check-preferences.ts --min-pairs 28 --min-buckets 9 --min-tasks 5 --min-read-pairs 13 --min-click-pairs 7 --min-type-pairs 8",
    "benchmark:traces:policy": "tsx benchmarks/web-control-plane/evaluate-trace-policy.ts",
    "benchmark:traces:policy:check": "tsx benchmarks/web-control-plane/evaluate-trace-policy.ts --check-only --require-best-policy semantic_keyword --min-pairwise 1 --min-pairwise-pairs 81 --min-pairwise-margin 0.5 --min-candidate-pairwise 1 --min-candidate-pairs 77 --min-candidate-margin 0.5 --min-threshold-accuracy 1",
    "compile": "tsc --noEmit",
    "test:e2e": "tsx --test host/test/*.test.ts",
    "test": "pnpm compile && pnpm test:e2e",
    "postinstall": "node scripts/postinstall.cjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.40",
    "@types/node": "^25.6.0",
    "@types/ws": "^8.18.1",
    "@webgpu/types": "^0.1.69",
    "typescript": "^5.9.3",
    "wxt": "^0.20.20"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.1.0",
    "@kessler/gemma-agent": "^1.0.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "marked": "^17.0.5",
    "tsx": "^4.21.0",
    "ws": "^8.20.0",
    "zod": "^4.4.1"
  }
}
