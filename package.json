{
  "name": "gemma-gem",
  "description": "Browser AI agent powered by Gemma 4 via WebGPU",
  "license": "Apache-2.0",
  "version": "0.3.0",
  "type": "module",
  "bin": {
    "gemma-gem-bridge": "host/bin/gemma-gem-bridge.cjs"
  },
  "files": [
    "host/bin",
    "host/scripts/stop-bridge.cjs",
    "docs/*.md",
    "host/src",
    "benchmarks/web-control-plane/action-reranker.weights.json",
    "scripts/postinstall.cjs",
    "shared/action-reranker.ts",
    "shared/bridge-messages.ts",
    "shared/bridge-settings.ts",
    "shared/json-schema.ts",
    "shared/messages.ts",
    "shared/models.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build --mode development",
    "build:prod": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "bridge": "node --import tsx host/src/index.ts",
    "bridge:http": "node --import tsx host/src/index.ts --http",
    "bridge:stop": "node host/scripts/stop-bridge.cjs",
    "browser:install": "tsx scripts/install-chrome-for-testing.ts",
    "browser:debug": "tsx scripts/launch-extension-debug.ts",
    "browser:model-ready": "tsx scripts/check-model-ready.ts",
    "benchmark:web": "tsx benchmarks/web-control-plane/run.ts",
    "benchmark:traces": "tsx benchmarks/web-control-plane/export-traces.ts",
    "benchmark:traces:check": "tsx benchmarks/web-control-plane/check-traces.ts --min-records 32 --min-positive 32 --min-selectors 27 --min-clicks 3 --min-candidate-buckets 15 --min-target-selector-records 4 --min-target-selector-matches 3 --min-target-selector-no-action-selectors 1 --min-target-selector-buckets 1 --min-target-selector-match-buckets 1 --min-target-selector-no-action-selector-buckets 1",
    "benchmark:traces:summary": "tsx benchmarks/web-control-plane/summarize-traces.ts",
    "benchmark:traces:training": "tsx benchmarks/web-control-plane/build-training-traces.ts",
    "benchmark:traces:training:check": "tsx benchmarks/web-control-plane/check-traces.ts --input benchmarks/web-control-plane/action-traces.training.jsonl --require-negative --require-candidate-pairs --min-records 94 --min-positive 53 --min-negative 41 --min-selectors 89 --min-clicks 23 --min-candidate-buckets 27 --min-paired-candidate-buckets 25 --min-target-selector-records 12 --min-target-selector-matches 6 --min-target-selector-mismatches 5 --min-target-selector-no-action-selectors 1 --min-target-selector-buckets 2 --min-target-selector-match-buckets 2 --min-target-selector-mismatch-buckets 2 --min-target-selector-no-action-selector-buckets 1",
    "benchmark:traces:training:summary": "tsx benchmarks/web-control-plane/summarize-traces.ts --input benchmarks/web-control-plane/action-traces.training.jsonl --output benchmarks/web-control-plane/action-traces.training.summary.md",
    "benchmark:traces:preferences": "tsx benchmarks/web-control-plane/build-preference-pairs.ts",
    "benchmark:traces:preferences:check": "tsx benchmarks/web-control-plane/check-preferences.ts --min-pairs 71 --min-buckets 25 --min-tasks 19 --min-read-pairs 42 --min-click-pairs 16 --min-type-pairs 13 --min-target-selector-pairs 6 --min-target-selector-values 2 --min-target-selector-buckets 5",
    "benchmark:traces:preferences:policy": "tsx benchmarks/web-control-plane/evaluate-preference-policy.ts",
    "benchmark:traces:preferences:policy:check": "tsx benchmarks/web-control-plane/evaluate-preference-policy.ts --check-only --require-best-policy semantic_keyword --min-accuracy 1 --min-pairs 71 --min-buckets 25 --min-tasks 19 --min-margin 3 --min-target-selector-accuracy 1 --min-target-selector-pairs 6 --min-target-selector-margin 10",
    "benchmark:traces:reranker": "tsx benchmarks/web-control-plane/build-reranker-preferences.ts",
    "benchmark:traces:reranker:check": "tsx benchmarks/web-control-plane/check-reranker-preferences.ts --min-pairs 71 --min-buckets 25 --min-tasks 19 --min-chosen-a 36 --min-chosen-b 35 --min-target-selector-pairs 6 --min-target-selector-values 2 --min-target-selector-buckets 5",
    "benchmark:traces:reranker:baseline": "tsx benchmarks/web-control-plane/evaluate-reranker-baseline.ts",
    "benchmark:traces:reranker:baseline:check": "tsx benchmarks/web-control-plane/evaluate-reranker-baseline.ts --check-only --require-best-policy learned_perceptron --min-pairs 71 --min-semantic-accuracy 1 --min-learned-accuracy 1 --min-learned-loto-accuracy 1 --min-learned-loto-margin 12 --min-learned-loso-accuracy 1 --min-learned-loso-margin 10 --min-target-selector-pairs 6 --min-target-selector-semantic-accuracy 1 --min-target-selector-semantic-margin 10 --min-target-selector-learned-accuracy 1 --min-target-selector-learned-margin 100 --min-target-selector-learned-loto-accuracy 1 --min-target-selector-learned-loto-margin 100 --min-target-selector-learned-loso-accuracy 1 --min-target-selector-learned-loso-margin 100",
    "benchmark:traces:reranker:weights:check": "tsx benchmarks/web-control-plane/check-reranker-weights.ts --min-pairs 71 --min-buckets 25 --min-tasks 19 --min-suites 8 --min-weights 452 --require-best-policy learned_perceptron --require-policy learned_perceptron_loso --min-policy-pairs 71 --min-policy-accuracy 1 --min-policy-margin 10 --min-recomputed-accuracy 1 --min-recomputed-margin 14 --require-target-selector-policy learned_perceptron --min-target-selector-policy-pairs 6 --min-target-selector-policy-accuracy 1 --min-target-selector-policy-margin 100 --min-target-selector-recomputed-accuracy 1 --min-target-selector-recomputed-margin 100 --require-feature=full_page_read=body --require-feature=full_page_read=narrow --require-feature=read_page_content_selector_role=source --require-feature=read_page_content_selector_role=destination --require-feature=scoped_target_selector=match --require-feature=scoped_target_selector=mismatch",
    "benchmark:traces:policy": "tsx benchmarks/web-control-plane/evaluate-trace-policy.ts",
    "benchmark:traces:policy:check": "tsx benchmarks/web-control-plane/evaluate-trace-policy.ts --check-only --require-best-policy semantic_keyword --min-records 94 --min-positive 53 --min-negative 41 --min-tasks 22 --min-candidate-buckets 27 --min-paired-candidate-buckets 25 --min-pairwise 1 --min-pairwise-pairs 160 --min-pairwise-margin 1.5 --min-candidate-pairwise 1 --min-candidate-pairs 155 --min-candidate-margin 1.5 --min-target-selector-candidate-pairwise 1 --min-target-selector-candidate-pairs 6 --min-target-selector-candidate-margin 1.5 --min-threshold-accuracy 1",
    "compile": "tsc --noEmit",
    "test:e2e": "tsx --test host/test/*.test.ts",
    "test": "pnpm compile && pnpm test:e2e",
    "postinstall": "node scripts/postinstall.cjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.40",
    "@types/node": "^25.6.0",
    "@types/ws": "^8.18.1",
    "@webgpu/types": "^0.1.69",
    "typescript": "^5.9.3",
    "wxt": "^0.20.20"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.1.0",
    "@kessler/gemma-agent": "^1.0.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "marked": "^17.0.5",
    "tsx": "^4.21.0",
    "ws": "^8.20.0",
    "zod": "^4.4.1"
  }
}
