{
  "name": "gemma-gem",
  "description": "Browser AI agent powered by Gemma 4 via WebGPU",
  "license": "Apache-2.0",
  "version": "0.3.0",
  "type": "module",
  "bin": {
    "gemma-gem-bridge": "host/bin/gemma-gem-bridge.cjs"
  },
  "files": [
    "host/bin",
    "host/scripts/stop-bridge.cjs",
    "docs/*.md",
    "host/src",
    "benchmarks/web-control-plane/action-reranker.weights.json",
    "scripts/postinstall.cjs",
    "shared/action-reranker.ts",
    "shared/bridge-messages.ts",
    "shared/bridge-settings.ts",
    "shared/json-schema.ts",
    "shared/messages.ts",
    "shared/models.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build --mode development",
    "build:prod": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "bridge": "node --import tsx host/src/index.ts",
    "bridge:http": "node --import tsx host/src/index.ts --http",
    "bridge:stop": "node host/scripts/stop-bridge.cjs",
    "browser:install": "tsx scripts/install-chrome-for-testing.ts",
    "browser:debug": "tsx scripts/launch-extension-debug.ts",
    "browser:model-ready": "tsx scripts/check-model-ready.ts",
    "benchmark:web": "tsx benchmarks/web-control-plane/run.ts",
    "benchmark:traces": "tsx benchmarks/web-control-plane/export-traces.ts",
    "benchmark:traces:check": "tsx benchmarks/web-control-plane/check-traces.ts --min-records 32 --min-positive 32 --min-selectors 27 --min-clicks 3 --min-candidate-buckets 14",
    "benchmark:traces:summary": "tsx benchmarks/web-control-plane/summarize-traces.ts",
    "benchmark:traces:training": "tsx benchmarks/web-control-plane/build-training-traces.ts",
    "benchmark:traces:training:check": "tsx benchmarks/web-control-plane/check-traces.ts --input benchmarks/web-control-plane/action-traces.training.jsonl --require-negative --require-candidate-pairs --min-records 86 --min-positive 50 --min-negative 36 --min-selectors 81 --min-clicks 23 --min-candidate-buckets 23 --min-paired-candidate-buckets 20",
    "benchmark:traces:training:summary": "tsx benchmarks/web-control-plane/summarize-traces.ts --input benchmarks/web-control-plane/action-traces.training.jsonl --output benchmarks/web-control-plane/action-traces.training.summary.md",
    "benchmark:traces:preferences": "tsx benchmarks/web-control-plane/build-preference-pairs.ts",
    "benchmark:traces:preferences:check": "tsx benchmarks/web-control-plane/check-preferences.ts --min-pairs 65 --min-buckets 20 --min-tasks 14 --min-read-pairs 36 --min-click-pairs 16 --min-type-pairs 13",
    "benchmark:traces:preferences:policy": "tsx benchmarks/web-control-plane/evaluate-preference-policy.ts",
    "benchmark:traces:preferences:policy:check": "tsx benchmarks/web-control-plane/evaluate-preference-policy.ts --check-only --require-best-policy semantic_keyword --min-accuracy 1 --min-pairs 65 --min-margin 3",
    "benchmark:traces:reranker": "tsx benchmarks/web-control-plane/build-reranker-preferences.ts",
    "benchmark:traces:reranker:check": "tsx benchmarks/web-control-plane/check-reranker-preferences.ts --min-pairs 65 --min-buckets 20 --min-tasks 14 --min-chosen-a 33 --min-chosen-b 32",
    "benchmark:traces:reranker:baseline": "tsx benchmarks/web-control-plane/evaluate-reranker-baseline.ts",
    "benchmark:traces:reranker:baseline:check": "tsx benchmarks/web-control-plane/evaluate-reranker-baseline.ts --check-only --require-best-policy learned_perceptron --min-pairs 65 --min-semantic-accuracy 1 --min-learned-accuracy 1 --min-learned-loto-accuracy 1 --min-learned-loto-margin 10 --min-learned-loso-accuracy 1 --min-learned-loso-margin 10",
    "benchmark:traces:reranker:weights:check": "tsx benchmarks/web-control-plane/check-reranker-weights.ts --min-pairs 65 --min-weights 305 --require-policy learned_perceptron_loso --min-policy-accuracy 1 --min-policy-margin 10 --min-recomputed-accuracy 1 --min-recomputed-margin 14 --require-feature=full_page_read=body --require-feature=full_page_read=narrow --require-feature=read_page_content_selector_role=source --require-feature=read_page_content_selector_role=destination",
    "benchmark:traces:policy": "tsx benchmarks/web-control-plane/evaluate-trace-policy.ts",
    "benchmark:traces:policy:check": "tsx benchmarks/web-control-plane/evaluate-trace-policy.ts --check-only --require-best-policy semantic_keyword --min-pairwise 1 --min-pairwise-pairs 153 --min-pairwise-margin 1.5 --min-candidate-pairwise 1 --min-candidate-pairs 149 --min-candidate-margin 1.5 --min-threshold-accuracy 1",
    "compile": "tsc --noEmit",
    "test:e2e": "tsx --test host/test/*.test.ts",
    "test": "pnpm compile && pnpm test:e2e",
    "postinstall": "node scripts/postinstall.cjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.40",
    "@types/node": "^25.6.0",
    "@types/ws": "^8.18.1",
    "@webgpu/types": "^0.1.69",
    "typescript": "^5.9.3",
    "wxt": "^0.20.20"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.1.0",
    "@kessler/gemma-agent": "^1.0.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "marked": "^17.0.5",
    "tsx": "^4.21.0",
    "ws": "^8.20.0",
    "zod": "^4.4.1"
  }
}
